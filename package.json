{
  "name": "thinkbreak-web-audio-builder",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @thinkbreak/builder dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "verify:package-imports": "node scripts/verify-package-imports.mjs",
    "verify:lockfile": "pnpm install --frozen-lockfile --lockfile-only",
    "verify": "pnpm verify:lockfile && pnpm db:check && pnpm build:packages && pnpm verify:package-imports && pnpm check && pnpm lint && pnpm test:unit && pnpm build",
    "build:railway": "pnpm verify",
    "start": "pnpm --filter @thinkbreak/builder start",
    "check": "pnpm -r check",
    "lint": "prettier --check apps packages && eslint --no-config-lookup --config eslint.config.js apps packages",
    "format": "prettier --write apps packages",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @thinkbreak/builder db:generate",
    "db:migrate": "pnpm --filter @thinkbreak/builder db:migrate",
    "db:check": "pnpm --filter @thinkbreak/builder db:check",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "typescript-eslint": "^8.60.1"
  }
}
